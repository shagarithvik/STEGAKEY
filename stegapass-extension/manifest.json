{
  "manifest_version": 3,
  "name": "StegaPass USB Password Manager",
  "version": "1.0.0",
  "description": "Offline steganographic USB-based password manager.",
  "permissions": ["storage", "scripting", "nativeMessaging", "activeTab", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}

